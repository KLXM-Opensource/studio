# Archive (git archive, GitHub-ZIP, Packagist-Dist für „composer create-project klxm/studio“): nur, was ein Projekt braucht.
# Laufzeit, gebaute Assets, Kits, Erweiterungen, tools/ (Build, Kit-Prüfung, Tutorials für eigene Kits), deploy/ und .claude/
# (allgemeine Skills und Schutz-Hooks) bleiben enthalten. Ausgenommen: CI des Kern-Repositorys und die Release-Prüfung des Kerns.
/.github                      export-ignore
/.gitattributes               export-ignore
/.claude/skills/release-check export-ignore
# Nur Quellen fürs Repository: die NativeCSS-Schriften liegen gebaut unter public/assets/kits/native/fonts (kits/native/build.mjs
# kopiert sie nur, wenn die Quelle da ist), die PHP-API-Referenz erzeugt die Verwaltung live (/admin/hilfe/php-api, docs:api)
/kits/native/vendor/ncss/fonts export-ignore
/docs/php-api.md              export-ignore

# Zeilenenden: Shell-Skripte und die Konsole immer LF (auch bei Checkout unter Windows)
*.sh        text eol=lf
/bin/console text eol=lf

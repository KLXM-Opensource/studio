# KLXM Studio – Jails für fail2ban (Beispiel). Plesk: Tools & Einstellungen → IP-Adressen sperren (Fail2Ban) → Jails → Jail hinzufügen;
# ohne Plesk: nach /etc/fail2ban/jail.d/klxm-studio.local kopieren, Filter nach /etc/fail2ban/filter.d/.
# logpath: je Installation die eigene Datei (Plesk: /var/www/vhosts/<domain>/httpdocs/storage/logs/security.log); mehrere Zeilen erlaubt.
# Eigene Adressen (Büro, Monitoring) unter ignoreip eintragen bzw. in Plesk auf die Liste vertrauenswürdiger IP-Adressen setzen.

[klxm-studio-auth]
enabled  = true
filter   = klxm-studio-auth
logpath  = /var/www/vhosts/example.org/httpdocs/storage/logs/security.log
port     = http,https
action   = iptables-multiport[name=klxm-studio-auth, port="http,https"]
maxretry = 10
findtime = 900
bantime  = 3600

[klxm-studio-probe]
enabled  = true
filter   = klxm-studio-probe
logpath  = /var/www/vhosts/example.org/httpdocs/storage/logs/security.log
port     = http,https
action   = iptables-multiport[name=klxm-studio-probe, port="http,https"]
maxretry = 3
findtime = 3600
bantime  = 86400

# Zugriffslog des Webservers: nicht vorhandene .php-Dateien anderer Systeme (/wp-login.php, /xmlrpc.php …) – erreichen KLXM Studio nie.
# Plesk: /var/www/vhosts/<domain>/logs/proxy_access_ssl_log (nginx vor Apache) bzw. access_ssl_log.
# Websites hinter Cloudflare o. Ä. auf demselben Server: deren Adressbereiche unter ignoreip, sonst wird der Proxy gesperrt.
[klxm-studio-probe-access]
enabled  = true
filter   = klxm-studio-probe-access
logpath  = /var/www/vhosts/example.org/logs/proxy_access_ssl_log
port     = http,https
action   = iptables-multiport[name=klxm-studio-probe-access, port="http,https"]
maxretry = 3
findtime = 3600
bantime  = 86400

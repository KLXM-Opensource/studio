# ─────────────────────────────────────────────────────────────────────────────
# BEISPIEL – GitHub-Actions-Workflow für das Repository EINES PROJEKTS (Agentur/Kundenwebsite),
# nicht für das öffentliche KLXM-Studio-Repository. Er ruft deploy/deploy.sh auf (Releases, Rollback).
#
# Einrichten im eigenen Website-Repository:
#   1. Datei nach .github/workflows/deploy.yml kopieren (Endung .example entfernen).
#   2. Settings → Environments: „staging“ und „production“ anlegen; bei „production“
#      „Required reviewers“ setzen (Freigabe durch eine Person).
#   3. Secrets je Umgebung anlegen (siehe unten). DEPLOY_ENV = Inhalt von deploy/targets/<ziel>.env
#      (Vorlage deploy/targets/example.env) – mindestens SSH_TARGET, BASE und URL, sonst bricht deploy.sh ab.
#   4. Optional: Push-Trigger anpassen (z. B. nur Tags) oder entfernen, wenn nur manuell deployt werden soll.
# Details: deploy/README.md bzw. Entwicklerhandbuch → „Staging & Deploy“.
# ─────────────────────────────────────────────────────────────────────────────
#
# Deploy: jeder Push auf main → Staging. Production nur manuell (Actions → Deploy → Run workflow)
# und mit Freigabe über die GitHub-Umgebung „production“ (Settings → Environments → Required reviewers).
#
# Secrets je Umgebung (staging / production):
#   DEPLOY_SSH_KEY    privater Schlüssel des Deploy-Benutzers
#   DEPLOY_KNOWN_HOSTS  Ausgabe von: ssh-keyscan server.example.de
#   DEPLOY_ENV        Inhalt von deploy/targets/<ziel>.env
name: Deploy

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      target:
        description: Ziel
        type: choice
        options: [staging, production]
        default: staging

concurrency: deploy-${{ github.event.inputs.target || 'staging' }}

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: ${{ github.event.inputs.target || 'staging' }}
    steps:
      - uses: actions/checkout@v4
      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.4'
          extensions: gd, sodium, pdo_sqlite, mbstring, intl
          tools: composer
      - uses: pnpm/action-setup@v4
        with:
          version: 10
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: Syntaxprüfung
        run: find app bin kits extensions -name '*.php' -not -path '*/node_modules/*' -print0 2>/dev/null | xargs -0 -n1 -P4 php -l > /dev/null
      - name: SSH vorbereiten
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.DEPLOY_SSH_KEY }}" > ~/.ssh/id_deploy && chmod 600 ~/.ssh/id_deploy
          echo "${{ secrets.DEPLOY_KNOWN_HOSTS }}" > ~/.ssh/known_hosts
          echo "${{ secrets.DEPLOY_ENV }}" > deploy/targets/${{ github.event.inputs.target || 'staging' }}.env
          echo 'SSH_OPTS="-i ~/.ssh/id_deploy"' >> deploy/targets/${{ github.event.inputs.target || 'staging' }}.env
      - name: Deploy
        run: bash deploy/deploy.sh ${{ github.event.inputs.target || 'staging' }}

# Vorlage: kopieren nach deploy/targets/staging.env bzw. production.env (nicht versionieren – .gitignore)
SSH_TARGET="kunde@server.example.de"          # Plesk: Systembenutzer des Abonnements (SSH-Zugang aktivieren)
BASE="/var/www/vhosts/kunde.de"                # Heimatverzeichnis des Abonnements
URL="https://www.kunde.de"                     # für den Rauchtest /health (Staging: https://staging.kunde.de)
PHP="/opt/plesk/php/8.4/bin/php"               # PHP-CLI passend zur Website
KEEP=5                                         # so viele Releases bleiben für Rollbacks
SITES="--all"                                  # oder "--site=default"
# SSH_OPTS="-p 22 -i ~/.ssh/deploy_key"
# CURL_OPTS="-u vorschau:passwort"             # Staging mit Passwortschutz
# RELOAD_CMD="sudo /usr/bin/systemctl reload plesk-php84-fpm"   # nach dem Umschalten (sonst kurz alter Stand im OPcache möglich)
# APP_DIR="/var/www/vhosts/kunde.de/httpdocs"   # ohne Releases (kein current/): Ordner der Installation
# SSH_CMD="sshpass -e ssh"; SCP_CMD="sshpass -e scp"   # Passwort-Anmeldung (Passwort in SSHPASS)

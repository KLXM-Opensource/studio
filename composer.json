{
    "name": "klxm/studio",
    "description": "Lean multi-site CMS without a framework: on-page block editor, kits, custom data tables, encrypted inboxes, AI features, REST API and MCP server. PHP 8.4, SQLite or MySQL.",
    "type": "project",
    "keywords": [
        "cms",
        "multisite",
        "block-editor",
        "inline-editing",
        "sqlite",
        "headless",
        "rest-api",
        "mcp",
        "ai",
        "gdpr",
        "accessibility",
        "privacy"
    ],
    "homepage": "https://studio.klxm.de",
    "license": "MIT",
    "authors": [
        {
            "name": "KLXM Crossmedia GmbH",
            "homepage": "https://klxm.de",
            "role": "Developer"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/KLXM-Studio/studio/graphs/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/KLXM-Studio/studio/issues",
        "source": "https://github.com/KLXM-Studio/studio",
        "docs": "https://studio.klxm.de",
        "security": "https://github.com/KLXM-Studio/studio/security/policy"
    },
    "require": {
        "php": ">=8.4.1",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "chillerlan/php-qrcode": "^6.0",
        "doctrine/dbal": "^4",
        "lbuchs/webauthn": "^2.2",
        "loupe/loupe": "^1.1",
        "rlanvin/php-rrule": "^3.0",
        "sabre/dav": "^4.7",
        "symfony/ai-generic-platform": "^0.14",
        "symfony/ai-mistral-platform": "^0.14",
        "symfony/ai-ollama-platform": "^0.14",
        "symfony/ai-open-ai-platform": "^0.14",
        "symfony/ai-platform": "^0.14",
        "symfony/ai-store": "^0.14",
        "symfony/http-client": "^8.0",
        "symfony/mailer": "^8.0"
    },
    "replace": {
        "nitotm/efficient-language-detector": "*",
        "joomla/string": "*"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "app/",
            "Joomla\\String\\": "lib/compat/joomla-string/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php bin/console install"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
